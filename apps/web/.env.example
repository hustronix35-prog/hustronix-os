# Copy to `.env.local` (gitignored). Do not commit real secrets.
#
# Next.js loads `.env.local` only on this app. The Express API loads the same file in
# development only (`NODE_ENV` not `production`) so OTP email uses identical SMTP_* — see root `.env.example`.
# Google OAuth (`GOOGLE_CLIENT_ID`, `GOOGLE_CLIENT_SECRET`, `GOOGLE_REDIRECT_URI`) must live in the **repo root** `.env`
# (the API process). They are not read from here by default; do not put `GOOGLE_*` here unless you intend to fill gaps only.
# In production, set SMTP_* on the API host and on Vercel/Next as your platform requires.

# Optional: absolute API origin. Leave empty to use same-origin `/api/*` (recommended with cookies).
# NEXT_PUBLIC_API_URL=http://127.0.0.1:3005
# Server-side proxy target when using same-origin API rewrites (default matches API dev port).
API_PROXY_TARGET=http://127.0.0.1:3005

# Optional: WebSocket base when split from HTTP (default derives from API port on localhost).
# NEXT_PUBLIC_WS_URL=ws://127.0.0.1:3005

# Early-access leads viewer (`/leads.html`) — same password as netlify-landing/.env
# EARLY_ACCESS_ADMIN_PASSWORD=

# Contact form + mirrored API OTP (same keys as root `.env` SMTP block)
CONTACT_TO=
CONTACT_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
