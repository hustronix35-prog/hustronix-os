# ── Telegram ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ── LLM (Google AI Studio) ───────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ── Security ──────────────────────────────────────────────
# Comma-separated Telegram user IDs allowed to interact
# Find yours: message @userinfobot on Telegram
ALLOWED_USER_IDS=7947808911

# HTTP API (Mission Control / Next.js UI). UI dev server CORS.
# Match Next.js default API rewrite in apps/web/next.config.ts
PORT=3005
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Browser URL for Next.js (Slack OAuth finishes here after callback HTML).
APP_ORIGIN=http://localhost:3000
REQUEST_BODY_LIMIT=1mb
REQUIRE_HTTPS=false
MAX_CONCURRENT_SESSIONS=10
# Override only if you operate a separate CSP policy at the API edge.
# CONTENT_SECURITY_POLICY=default-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'
# Optional HMAC key for tamper-evident ledger event signatures. Use a 32+ byte random secret in production.
# LEDGER_SIGNING_KEY=

# Automation key for scripts/CI only (x-api-key + x-user-id). Use a long random value in production.
MISSION_CONTROL_API_KEY=

# Local dev automation (off by default): loopback + API key + x-user-id header
# ALLOW_LOOPBACK_AUTH=1
# ALLOW_API_KEY_SYSTEM_PRINCIPAL=0
# ALLOW_LEGACY_UID_COOKIE=0
# ALLOW_WS_SESSION_QUERY=0

# Production database target (runtime cutover requires DATABASE_TYPE=postgres after migration).
# Local/dev remains SQLite unless explicitly changed.
DATABASE_TYPE=sqlite
# SQLite file path (relative to repo root or absolute). Docker/volumes: /app/data/hustronix.db
SQLITE_PATH=./data/hustronix.db
# DATABASE_URL=postgres://user:password@host:5432/hustronix
# POSTGRES_SSL=true
# REDIS_URL=redis://...
# JWT_ACCESS_TOKEN_TTL_SECONDS=900
# JWT_REFRESH_TOKEN_TTL_DAYS=30
# JWT_PRIVATE_KEY_PEM=
# JWT_PUBLIC_KEY_PEM=
# INTERNAL_SERVICE_KEYS_JSON=

# ── At-rest encryption for stored OAuth tokens ───────────────────────────
# Required to enable ANY integration (Slack, GitHub, Google, Microsoft, Notion, Jira, Linear).
# Generate with: openssl rand -hex 32 (or any 32+ char random string).
# Rotating this key requires re-encrypting `oauth_connections` — handle with a migration, not a silent restart.
OAUTH_TOKEN_ENCRYPTION_KEY=

# ── Slack OAuth (workspace install; bot token stored in SQLite) ──────────
# Slack app: https://api.slack.com/apps → Your App → Basic Information / OAuth & Permissions
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Signing secret for POST /api/integrations/slack/events (Event Subscriptions → Request URL).
# Required for Slack → external_signals ingestion (HMAC verification).
SLACK_SIGNING_SECRET=
# Must match exactly one URL under Slack → OAuth & Permissions → Redirect URLs
# Use UI origin so the session cookie is set on the same host as Next (via /api rewrite).
SLACK_REDIRECT_URI=http://localhost:3000/api/oauth/slack/callback

# ── Google sign-in (OAuth 2.0 Web client) ───────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── GitHub sign-in (OAuth App) ──────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# =========================================================================
# Integration OAuth — separate from sign-in OAuth above. Connects a *customer*
# to their own Slack/GitHub/Microsoft/Google/Notion/Jira/Linear workspace so we
# can ingest signals from THEIR data. Callbacks land at:
#   APP_ORIGIN/api/oauth/<provider>/callback
# Set redirect URI overrides only if you serve the API on a different host.
# =========================================================================

# ── GitHub user-OAuth (signal extraction; per-user repo webhook auto-register) ──
# Create at https://github.com/settings/developers (OAuth App, NOT GitHub App)
#   Authorization callback URL: <APP_ORIGIN>/api/oauth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Shared webhook secret used to verify incoming GitHub webhook POSTs (HMAC-SHA256).
# Set on the App side AND echoed here. Auto-generated webhooks reuse this value.
GITHUB_WEBHOOK_SECRET=
# OAUTH_GITHUB_REDIRECT_URI=  # only set if different from APP_ORIGIN/api/oauth/github/callback

# ── Google (Calendar + Gmail signal extraction, single OAuth client) ─────
# Same Google Cloud project as sign-in OAuth is fine; you can also use a separate Web client.
#   Authorized redirect URI: <APP_ORIGIN>/api/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional Pub/Sub topic for Gmail push (set up in https://console.cloud.google.com/cloudpubsub).
# Without this we fall back to a 5-minute history.list poll worker (works, just less realtime).
GMAIL_PUBSUB_TOPIC=
# OAUTH_GOOGLE_REDIRECT_URI=  # only set if different from APP_ORIGIN/api/oauth/google/callback

# ── Microsoft (Teams + Outlook Calendar + Outlook Mail, single Azure AD app) ──
# Register at https://entra.microsoft.com → App registrations (multi-tenant, "Accounts in any org dir + personal")
#   Redirect URI: <APP_ORIGIN>/api/oauth/microsoft/callback
# Required Graph delegated scopes: User.Read, Calendars.Read, Mail.Read, ChannelMessage.Read.All, Chat.Read
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Webhook validation secret for Graph change-notifications.
# Echoed back to Graph during subscription creation; verified on every webhook delivery.
MICROSOFT_WEBHOOK_CLIENT_STATE=
# OAUTH_MICROSOFT_REDIRECT_URI=  # only set if different from APP_ORIGIN/api/oauth/microsoft/callback

# ── Notion (per-workspace OAuth + poll worker) ───────────────────────────
# Create a Public integration at https://www.notion.so/my-integrations
#   Redirect URI: <APP_ORIGIN>/api/oauth/notion/callback
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
# OAUTH_NOTION_REDIRECT_URI=

# ── Jira (Atlassian 3LO OAuth + webhook auto-register) ───────────────────
# Create at https://developer.atlassian.com/console/myapps/ → OAuth 2.0 (3LO)
#   Callback URL: <APP_ORIGIN>/api/oauth/jira/callback
#   Permissions: read:jira-work, read:jira-user, manage:jira-webhook, offline_access
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
# Shared secret used to verify webhook POSTs from Jira (sent as `X-Hub-Signature` header).
JIRA_WEBHOOK_SECRET=
# OAUTH_JIRA_REDIRECT_URI=

# ── Linear (GraphQL webhooks auto-created on connect) ────────────────────
# Create at https://linear.app/settings/api/applications
#   Callback URL: <APP_ORIGIN>/api/oauth/linear/callback
LINEAR_OAUTH_CLIENT_ID=
LINEAR_OAUTH_CLIENT_SECRET=
# Webhook signing secret (Linear → Settings → API → Webhooks).
LINEAR_WEBHOOK_SECRET=
# OAUTH_LINEAR_REDIRECT_URI=
# Bot scopes (space-separated). Tune to what your app needs.
# Add groups:history / im:history if you subscribe to those message.* events in Slack app settings.
SLACK_BOT_SCOPES=app_mentions:read,channels:history,chat:write,commands
# Optional: limit which Slack channels create signals (channel IDs, comma-separated). Deny evaluated before allow.
# SLACK_INGEST_CHANNEL_DENYLIST=C012345,C067890
# SLACK_INGEST_CHANNEL_ALLOWLIST=C0ABC111
# Optional: full authorize URL if you skip server-side start (advanced).
# OAUTH_SLACK_URL=

# ── SMTP (contact form + API OTP) ─────────────────────────────────────────
# Put real values only in a gitignored file: copy this block to repo root `.env` and/or `apps/web/.env.local`.
# Production: set these in your host’s secret manager (Fly `secrets set`, Render dashboard, etc.) — never bake
# passwords into the image or commit them. The API reads `apps/web/.env.local` only when NODE_ENV is not
# `production`, so deployed servers must define SMTP_* on the API process itself.
#
# Same variable names as `apps/web/.env.example` / Next `src/app/api/contact/route.ts`.
# When host, user, pass, and a resolvable From are set, API register/login require a 6-digit email OTP.
# Gmail app passwords with spaces must be quoted, e.g. SMTP_PASS="abcd efgh ijkl mnop"
# Typical: port 587, SMTP_SECURE=false (matches Next contact route).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_FROM=
# Optional: CONTACT_TO=hello@... (contact route only)
# Optional: EARLY_ACCESS_TO=hello@... (early access notifications; defaults to CONTACT_TO)
# OTP envelope defaults: OTP_FROM → EMAIL_FROM → SMTP_USER → CONTACT_FROM → EMAIL_ADDRESS
# OTP_FROM=
# OTP_FROM_NAME=Hustronix
#
# Legacy fallbacks (if SMTP_* unset): EMAIL_SMTP_* / EMAIL_ADDRESS / EMAIL_PASSWORD
# EMAIL_ADDRESS=
# EMAIL_PASSWORD=
# EMAIL_FROM=
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_SECURE=
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5

# ── TOTP / app-based 2FA (API) ───────────────────────────────────────────
# Required to encrypt TOTP secrets at rest and to verify sign-in for accounts with 2FA enabled.
# Use a long random string (e.g. openssl rand -hex 32). Changing it invalidates existing stored secrets.
TOTP_ENCRYPTION_KEY=
# Optional: issuer name in authenticator apps (default Hustronix).
# TOTP_ISSUER=Hustronix
# Optional: time window for the post-password TOTP step (minutes, default 5).
# TOTP_LOGIN_PENDING_MINUTES=5
# TOTP_LOGIN_MAX_ATTEMPTS=8
# TOTP_BACKUP_CODE_COUNT=10

# ── Agent Loop (cost / latency) ───────────────────────────
# Cost-focused caps are ON by default (history 8, iterations 3, max tokens 512, tighter context).
# Disable with: LLM_COST_SAVER=0
# LLM_COORDINATOR_HAIKU=1  → main chat coordinator uses Haiku (fast tier) instead of Sonnet — much cheaper, weaker tools.
# Fewer rounds = cheaper (defaults: 3 with cost-saver, override with MAX_ITERATIONS).
MAX_ITERATIONS=3
# Recent chat messages in context — lower = cheaper (default 8 with cost-saver).
CHAT_HISTORY_MESSAGES=8
# Full agent turn (LLM + tools, multiple iterations). Default 360000 = 6 min.
AGENT_GLOBAL_TIMEOUT_MS=360000
# Streaming: reset stall timer while tokens arrive (default 90000 ms).
LLM_STREAM_IDLE_MS=90000
# Hard cap per streamed completion — cost guard (default 240000 ms).
LLM_STREAM_MAX_MS=240000
# Legacy non-stream path only (rare).
LLM_CHAT_TIMEOUT_MS=180000
# Fast tier / assistant max reply length (default 1024–2048). Chat coordinator uses LLM_MAX_OUTPUT_TOKENS_PREMIUM.
# LLM_MAX_OUTPUT_TOKENS=2048
# Chat coordinator (premium) — raise if roadmaps cut off mid-phase (default 4096).
# LLM_MAX_OUTPUT_TOKENS_PREMIUM=4096

# ── LLM (Chat / coordinator) ──────────────────────────────
# Required for in-app Chat and agent. Prefer env keys over committing secrets.
ANTHROPIC_API_KEY=
# Coordinator (premium tier). Default Claude Sonnet 4.x (`claude-sonnet-4-6`). Retired 3.5 Sonnet snapshots redirect at runtime.
# SQLite `anthropicModel` overrides premium when env omits ANTHROPIC_MODEL_PREMIUM / ANTHROPIC_MODEL.
ANTHROPIC_MODEL_PREMIUM=claude-sonnet-4-6
# Sub-agents + intelligence pipelines (fast tier). Default Haiku 4.5 if unset; non-Haiku ids are coerced to this default.
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
OPENAI_API_KEY=
# Default chat model when ACTIVE_PROVIDER=openai (cheaper than full gpt-4o).
OPENAI_CHAT_MODEL=gpt-4o-mini
# anthropic | openai
ACTIVE_PROVIDER=anthropic

# ── Billing (Settings UI) ─────────────────────────────────
# When a payment gateway is integrated, set to 1 so the UI can surface invoice rows from the DB.
# Until then, Settings → Billing stores only self-reported contact/plan text in `settings` keys under `billing.*`.
BILLING_PROVIDER_CONFIGURED=0
