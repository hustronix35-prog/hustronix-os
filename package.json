{
  "name": "hustronix-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Hustronix platform monorepo - API, web app, shared packages, infra, and ops.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:shared && npm run dev:stack",
    "dev:api": "npm -w @hustronix/api run dev",
    "dev:web": "npm -w @hustronix/os-ui run dev",
    "dev:web:legacy": "npm -w @hustronix/web run dev",
    "dev:stack": "concurrently -k -n api,os-ui -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:unified": "npm run build:shared && npm -w @hustronix/api run dev:unified",
    "build": "npm run build:all",
    "build:shared": "npm -w @hustronix/shared run build",
    "build:api": "npm -w @hustronix/api run build",
    "build:web": "npm -w @hustronix/os-ui run build",
    "build:web:legacy": "npm -w @hustronix/web run build",
    "export:netlify-landing": "node scripts/export-netlify-landing.mjs",
    "build:plainlandingpage": "node scripts/build-plainlandingpage.mjs",
    "dev:landing": "cd netlify-landing && npm run dev",
    "build:all": "npm run build:shared && npm run build:api && npm run build:web",
    "start": "npm -w @hustronix/api run start",
    "start:unified": "npm -w @hustronix/api run start:unified",
    "start:prod": "npm run build:all && npm run start:unified",
    "ui:dev": "npm run dev:web",
    "ui:build": "npm run build:web",
    "ui:start": "npm -w @hustronix/os-ui run start",
    "db:pg:migrate": "node ops/scripts/postgres-migrate.mjs",
    "qa:ui": "node ops/scripts/_qa-ui-pass.mjs",
    "security:launch": "node ops/scripts/security-launch-check.mjs",
    "report:readable": "node ops/scripts/markdown-to-readable.mjs",
    "report:pdf": "node ops/scripts/markdown-to-readable.mjs --pdf",
    "smoke:intelligence": "npm -w @hustronix/api run smoke:intelligence",
    "nango:bootstrap": "node ops/scripts/nango-bootstrap-integrations.mjs",
    "nango:bootstrap:all": "node ops/scripts/nango-bootstrap-integrations.mjs --all",
    "hsog:ingest": "tsx ops/scripts/hsog-ingest.ts",
    "test:hsog-ingest": "tsx --test ops/scripts/hsog-ingest.test.ts",
    "hsog:heavy": "tsx ops/scripts/hsog-heavy-flow.ts",
    "test:hsog-heavy": "tsx --test ops/scripts/hsog-heavy-flow.test.ts",
    "hsog:day-taste": "tsx ops/scripts/hsog-day-taste.ts",
    "hsog:seed-spandan": "tsx ops/scripts/hsog-seed-account.ts --user spandan --through-day 132",
    "hsog:full-system": "tsx ops/scripts/hsog-full-system.ts --through-day 132",
    "hsog:export-blind": "tsx ops/scripts/hsog-export-blind.ts",
    "hsog:customer-path": "tsx ops/scripts/hsog-customer-path.ts --mode chrono --through-day 132",
    "hsog:customer-path:intelligence": "tsx ops/scripts/hsog-customer-path.ts --mode intelligence --through-day 132",
    "hsog:customer-path:all": "tsx ops/scripts/hsog-customer-path.ts --mode all --through-day 132",
    "hsog:generalization": "tsx ops/scripts/hsog-generalization.ts",
    "hsog:open-world": "tsx ops/scripts/hsog-open-world.ts",
    "hsog:missing-evidence": "tsx ops/scripts/hsog-missing-evidence.ts",
    "hsog:talk-complete": "tsx ops/scripts/hsog-talk-complete.ts",
    "hsog:outcome-learning-probe": "tsx ops/scripts/hsog-outcome-learning-probe.ts",
    "hsog:operating-loop": "tsx ops/scripts/hsog-operating-loop.ts",
    "dump:os-state": "tsx ops/scripts/dump-os-state.ts",
    "qa:os-ui-click": "tsx ops/scripts/qa-os-ui-click-pass.ts",
    "qa:full-system": "tsx ops/scripts/hustronix-full-system-qa.ts",
    "test:talk-wave0": "tsx --test ops/scripts/talk-wave0.test.ts",
    "test:wave3-completion": "tsx --test ops/scripts/wave3-completion.test.ts",
    "test:wave3-evaluation": "tsx --test ops/scripts/wave3-evaluation.test.ts",
    "test:wave3-learning": "tsx --test ops/scripts/wave3-learning.test.ts",
    "qa:operating-loop": "tsx ops/scripts/hustronix-operating-loop-qa.ts",
    "test:operating-loop": "tsx --test ops/scripts/operating-loop.test.ts",
    "test:hsog-day-taste": "tsx --test ops/scripts/hsog-day-taste.test.ts",
    "test:os-enforcement": "tsx --test ops/scripts/os-enforcement.test.ts",
    "test:clarification": "tsx --test ops/scripts/clarification.test.ts",
    "test:org-intelligence": "tsx --test ops/scripts/org-intelligence.test.ts",
    "test:production-readiness": "tsx --test ops/scripts/production-readiness.test.ts",
    "benchmark:company-reality": "tsx ops/scripts/company-reality-benchmark.ts",
    "probe:founder-journey": "tsx ops/scripts/founder-journey-probe.ts",
    "probe:limitations": "tsx ops/scripts/limitation-probes.ts",
    "test:hardening": "tsx --test ops/scripts/hardening-program.test.ts",
    "test:talk-company-brain": "tsx --test ops/scripts/talk-company-brain.test.ts",
    "test:talk-reasoning": "tsx --test ops/scripts/talk-reasoning.test.ts",
    "test:talk-synthesis": "tsx --test ops/scripts/talk-synthesis.test.ts",
    "test:talk-general": "tsx --test ops/scripts/talk-general.test.ts",
    "test:talk-v2": "tsx --test ops/scripts/talk-v2.test.ts",
    "test:talk-v2-1": "tsx --test ops/scripts/talk-v2-1-founder-hardening.test.ts",
    "test:talk-v2-2": "tsx --test ops/scripts/talk-v2-2-hardening.test.ts",
    "founder:validation": "tsx ops/scripts/talk-founder-validation.ts",
    "export:founder-session": "tsx ops/scripts/export-founder-session.ts",
    "test:founder-validation-harness": "tsx --test ops/scripts/talk-founder-validation-harness.test.ts"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "^4.11.3",
    "axe-core": "^4.11.4",
    "concurrently": "^9.2.0",
    "github-markdown-css": "^5.9.0",
    "markdown-it": "^14.1.1",
    "markdown-it-multimd-table": "^4.2.3",
    "puppeteer": "^24.40.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
