{
  "name": "gravityclaw",
  "version": "1.0.0",
  "description": "Hustronix decision OS — ledger, auditor, agent (HTTP/WS), optional UI",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:stack": "concurrently -k -n api,ui -c cyan,magenta \"npm run dev\" \"npm run ui:dev\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "ui:dev": "npm --prefix hustronix-ui run dev",
    "ui:build": "npm --prefix hustronix-ui run build",
    "ui:start": "npm --prefix hustronix-ui run start",
    "qa:ui": "node scripts/_qa-ui-pass.mjs",
    "report:readable": "node scripts/markdown-to-readable.mjs",
    "report:pdf": "node scripts/markdown-to-readable.mjs --pdf",
    "dev:unified": "tsx watch src/unified-server.ts",
    "start:unified": "node dist/unified-server.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.86.1",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pinecone-database/pinecone": "^7.1.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "duck-duck-scrape": "^2.2.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "googleapis": "^171.4.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "openai": "^4.82.0",
    "puppeteer": "^24.40.0",
    "uuid": "^13.0.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "^4.11.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "axe-core": "^4.11.4",
    "github-markdown-css": "^5.9.0",
    "markdown-it": "^14.1.1",
    "markdown-it-multimd-table": "^4.2.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "concurrently": "^9.2.0"
  }
}
