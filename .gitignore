node_modules/
dist/
# Next.js build output (monorepo safety)
apps/web/.next/
.next/

# Secrets — never commit real values (use `.env.example` / `apps/web/.env.example` as templates only).
.env
.env.*
!.env.example
# Google Cloud “Download JSON” OAuth clients — keep outside the repo or here only if ignored.
client_secret*.json
*client_secret*.json
*.apps.googleusercontent.com.json

# SQLite — runtime DB, journals, and backups
*.db
*.db-journal
*.db-shm
*.db-wal
*.db.bak*
*.db.backup*
hustronix.db*
graph_memory.db*
/data/*
!data/.gitkeep

# Legacy UI path after monorepo migration
hustronix-ui/
# Nested duplicate of apps/os-ui (do not commit; product UI is apps/os-ui)
/new ui/

# Local dev data / outreach (never commit real leads)
leads.csv
apps/api/public/drafts/**
!apps/api/public/drafts/README.md

# Local media / scraped brag assets
brag-output/

# TypeScript incremental build info
*.tsbuildinfo
apps/web/tsconfig.tsbuildinfo

# OS noise
.DS_Store
Thumbs.db

# Retention: dev scratch, probes, large reference skill packs (not product runtime)
scratch/
tmp/
skills/pm_pack/
_hero_*.txt

# Local env variants (explicit; root `.env.*` already covers most)
plainlandingpage/.env.leads
apps/web/.env.local

# Logs and local SQLite sidecars
*.log
backend_stdout.log
backend_stderr.log
graph_memory.db-shm
graph_memory.db-wal
workspace/logs/

# Generated audit screenshots (keep directory; ignore blobs)
public/audits/*.png
apps/api/public/audits/*.png

# Root-level strategy/planning drafts (optional local copies; tracked product notes live in docs/)
/Hustronix_Alignment_Strategy.md
/Marketing_Plan.md
/PRD.md
/System_Architecture.md
.gstack/

# Generated by ops/scripts/linkedin-scraper.ts
ops/scripts/cache/*
